# ====================================================================
# TrendPicker 非敏感配置模板 (仅配置, 不含凭据)
# 敏感凭据 (API Key / AppSecret / LLM Key) 必须存入 macOS Keychain via keyring
# 真实 .env 不进版本库 (.gitignore), 此模板进库
# ====================================================================

# ---- 类目与价格带配置 ----
TRENDPICKER_CATEGORY_ID=
TRENDPICKER_PRICE_BAND_MIN=0
TRENDPICKER_PRICE_BAND_MAX=9999

# ---- 模型版本 ----
TRENDPICKER_ACTIVE_MODEL_VERSION=v1_rules

# ---- 数据库 (本地 SQLite; P2 后切换 PostgreSQL) ----
TRENDPICKER_DB_PATH=trendpicker.db

# ---- 爆款定义 (与方案一致) ----
TRENDPICKER_HOT_TOP_PERCENT=5
TRENDPICKER_HOT_MIN_DAYS=5
TRENDPICKER_HOT_WINDOW_DAYS=14

# ---- Keychain 服务名 (本地凭据隔离) ----
TRENDPICKER_KEYRING_SERVICE=trendpicker

# ---- 回测窗口 (P2 启用) ----
TRENDPICKER_BACKTEST_LOOKBACK_DAYS=30
TRENDPICKER_BACKTEST_PREDICT_HORIZON=14
TRENDPICKER_BACKTEST_VALIDATE_HORIZON=14

# ---- CI 环境标志 ----
# 在 GitHub Actions 中通过 CI=true 触发 get_credential 走环境变量回退路径
CI=
